# .clang-tidy — static analysis policy for src/daemon (enforced in CI).
#
# Gate: clang-tidy <file> -p build --warnings-as-errors='*'
# (see .github/workflows/ci.yml, clang-tidy job).
#
# Deliberately scoped: bugprone / concurrency / misc / performance plus two
# safe modernizations. Readability and style checks are excluded — formatting
# is not part of the merge gate. FlowKey/FlowStats stay plain aggregates, so
# misc-non-private-member-variables-in-classes is disabled.
#
# Three checks are disabled with rationale (not suppressions of real bugs):
# - bugprone-easily-swappable-parameters: API signatures it flags are either
#   frozen by external ABI (libbpf's dispatch_event(void*, void*, size_t))
#   or stable internal contracts covered by unit tests (SlidingWindowCounter::
#   add, observe_syn, count_distinct_ports_from). Renaming churn buys nothing.
# - performance-unnecessary-value-param: std::stop_token is a cheap
#   shared-ownership handle that the standard library itself passes by value
#   (condition_variable_any::wait takes stop_token by value; jthread hands it
#   to the worker by value). By-value is the idiomatic spelling here.
# - misc-include-cleaner: its provider DB varies by clang-tidy version
#   (tidy-18 does not know SOL_SOCKET/SO_REUSEADDR/SO_RCVTIMEO/timeval come
#   from <sys/socket.h>/<sys/time.h>, and newer versions add new std::
#   findings on every release). Enforcing it as an error turns the weekly
#   toolchain-drift cron red for false positives. Direct includes are still
#   maintained by hand; the compiler (-Werror) is the include gate.

# NOTE: in clang-tidy, LATER globs take precedence, so every disable MUST
# come after its parent glob — a `-check` placed before `group-*` is silently
# re-enabled. All disables live at the end of the list for this reason.

Checks: >
  bugprone-*,
  concurrency-*,
  misc-*,
  modernize-use-nullptr,
  modernize-use-override,
  performance-*,
  cppcoreguidelines-avoid-goto,
  -bugprone-easily-swappable-parameters,
  -misc-non-private-member-variables-in-classes,
  -misc-include-cleaner,
  -performance-unnecessary-value-param

WarningsAsErrors: '*'
HeaderFilterRegex: 'src/daemon/.*'
FormatStyle: file
CheckOptions:
  - key: bugprone-sizeof-expression.WarnOnSizeOfConstant
    value: true
  - key: concurrency-mt-unsafe.FunctionSet
    value: 'posix'
  - key: performance-move-const-arg.CheckTriviallyCopyableMove
    value: true
